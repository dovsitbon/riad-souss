# Formulaire de contact (envoi via Resend : https://resend.com)
# Sans ces variables, le formulaire répond honnêtement qu'il n'est pas encore activé
# et invite à appeler le restaurant.
RESEND_API_KEY=
# Adresse qui reçoit les demandes (boîte du restaurant)
CONTACT_TO=
# Expéditeur vérifié dans Resend, ex. "Site Riad Souss <site@votre-domaine.fr>"
CONTACT_FROM=
